# ---------------------------------------------------------------------------
# Vintage-Script / GHS demo — environment
#
# The app runs with ZERO configuration. Every value below is optional.
# With no .env file at all you get the offline demo, which is what the
# pastor meeting needs (GHS_MVP_Brief.md §6).
# ---------------------------------------------------------------------------

# The data source behind the api seam (src/services/api.ts).
#   demo     — bundled/static data + localStorage. Works offline. DEFAULT.
#   supabase — live Supabase. Requires the two VITE_SUPABASE_* values below.
VITE_DATA_SOURCE=demo

# Only read when VITE_DATA_SOURCE=supabase.
# The anon key is a public, row-level-security-gated key — but still do not
# commit a real one. Copy this file to .env and fill it in there.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Artifact-of-the-day image/blurb source (GHS_ProductArchitecture.md §14.3).
#   cache — serve from the curated cached list. Offline-safe. DEFAULT.
#   live  — fetch the curated title live from the Wikipedia REST summary API.
VITE_ARTIFACT_SOURCE=cache

# Which tenant to boot as. Multi-tenancy spine, GHS_ProductArchitecture.md §4.
VITE_DEFAULT_CHURCH_ID=ghs
